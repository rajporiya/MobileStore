# WhatsApp Cloud API: create and approve a 3-variable template in Meta first.
# Template body example: Hi {{1}}, your order #{{2}} for {{3}} has been placed successfully.
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ORDER_TEMPLATE=order_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Pin this only if Meta requires a different Graph API version.
WHATSAPP_API_VERSION=v22.0

# Email OTP for account registration (Resend)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Mobile Store <accounts@your-verified-domain.com>
