```gitignore
# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build
dist/
build/

# Coverage
coverage/

# Temporary files
tmp/
temp/

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/

# Runtime
*.pid
*.seed
*.pid.lock

# Uploads
uploads/
public/uploads/

# Cache
.cache/
.npm/
.eslintcache

# Local database files
*.sqlite
*.sqlite3
```
